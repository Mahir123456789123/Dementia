# Keep only the application source and the primary notebook at the repository root.
*
!.gitignore
!Major_Dementia.ipynb
!backend/
!backend/**
!frontend/
!frontend/**

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python environments, caches, and secrets
venv/
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.env
**/.env.*

# Frontend dependencies and build output
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/

# Logs and common build output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
coverage/
.ipynb_checkpoints/